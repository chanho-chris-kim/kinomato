{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinomato",
  // worker.ts wraps OpenNext's generated .open-next/worker.js and adds the
  // Cron Trigger's scheduled handler (docs/onboarding-spec.md §11.6).
  "main": "worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Two Cron Triggers (the Free plan allows 5 per account), each run by
  // worker.ts's scheduled handler and told apart by its cron string
  // (app/scheduledJobs.ts, keep them in step); no route reaches either.
  // "0 10 * * *": the daily retention job (docs/onboarding-spec.md §11.6),
  // 10:00 UTC, night in Vancouver. "0 * * * *": the hourly weekly loop
  // (app/weeklyLoop.ts): locks, unconfirmed nights, unopened drafts.
  // The site's own origin, for links in emails the hourly job sends
  // (reminders, app/reminders.ts): the job has no request to read it from.
  // Not a secret. Move to https://kinomato.com at launch.
  "vars": {
    "APP_ORIGIN": "https://dev.kinomato.com"
  },
  "triggers": {
    "crons": ["0 10 * * *", "0 * * * *"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kinomato"
    }
  ],
  // Enabled deliberately: this is how production gets debugged. Prefer
  // not to authenticate wrangler locally, so `wrangler tail` isn't the
  // plan — dashboard log visibility is.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
