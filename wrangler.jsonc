{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinomato",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kinomato"
    }
  ],
  // Enabled deliberately: this is how production gets debugged. Prefer
  // not to authenticate wrangler locally, so `wrangler tail` isn't the
  // plan — dashboard log visibility is.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
