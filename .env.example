DATABASE_URL=postgres://user:password@localhost:5432/kinomato

# A dedicated Neon branch that's safe to wipe — never dev.kinomato.com's
# database. e2e/global-setup.ts re-seeds it fresh at the start of every
# E2E run. See CLAUDE.md's Stack section.
E2E_DATABASE_URL=postgres://user:password@localhost:5432/kinomato_e2e

# v4 read-access token, sent as an Authorization: Bearer header —
# server-side only, never NEXT_PUBLIC_. lib/tmdb.ts falls back to the
# fixture when this is unset, which is what E2E/CI rely on to run
# without a token or real network access.
TMDB_READ_TOKEN=

# Server-side only, never NEXT_PUBLIC_. lib/email.ts skips the real
# Resend call when this is unset (logs the magic link instead) — same
# reasoning as TMDB_READ_TOKEN, and what E2E/CI rely on to run without
# a key or a real inbox (they read the generated token straight out of
# the magic_links table).
RESEND_API_KEY=
