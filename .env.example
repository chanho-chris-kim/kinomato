DATABASE_URL=postgres://user:password@localhost:5432/kinomato

# Your OWN Neon branch for local E2E runs (e.g. `e2e-local`) — never
# dev.kinomato.com's database, and never the branch CI uses (CI has its
# own, in the E2E_DATABASE_URL repo secret). e2e/global-setup.ts drops
# and recreates its whole schema at the start of every run, so sharing a
# branch with CI means each wipes the other mid-run. See CLAUDE.md's
# Conventions section.
E2E_DATABASE_URL=postgres://user:password@localhost:5432/kinomato_e2e

# v4 read-access token, sent as an Authorization: Bearer header —
# server-side only, never NEXT_PUBLIC_. lib/tmdb.ts falls back to the
# fixture when this is unset, which is what E2E/CI rely on to run
# without a token or real network access.
TMDB_READ_TOKEN=

# Server-side only, never NEXT_PUBLIC_. lib/email.ts skips the real
# Brevo call when this is unset (logs the code and link instead) — same
# reasoning as TMDB_READ_TOKEN, and what E2E/CI rely on to run without
# a key or a real inbox (they set a known code on the sign-in row
# instead; e2e/signIn.ts).
BREVO_API_KEY=

# Server-side only, never NEXT_PUBLIC_. HMAC key for sign-in codes
# (lib/authCredentials.ts). Optional locally (a fixed dev value is used);
# REQUIRED in production, where it throws if unset. Set it on the Worker
# with `wrangler secret put AUTH_SECRET` — any long random string, e.g.
# `openssl rand -hex 32`. Changing it invalidates codes already sent,
# nothing else.
AUTH_SECRET=
